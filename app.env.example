DB_DRIVER=postgres
DB_SOURCE=postgres://postgres:change-me@127.0.0.1:5432/postgres?sslmode=disable&timezone=Asia/Shanghai
SERVER_ADDRESS=0.0.0.0:3000
ALLOWED_ORIGINS=http://localhost:5173,https://myproject.com
# Local-development placeholder only. Replace it in every deployed environment.
TOKEN_SYMMETRIC_KEY=local-dev-only-change-me-0000000
TRAFFIC_DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=15s
ACCESS_TOKEN_DURATION=30m
DEFAULT_LOCALE=zh
DEBUG=false
