APP_NAME=go-fiber-template
ENVIRONMENT=development
DB_DRIVER=pgx
DB_SOURCE=postgres://postgres:change-me@127.0.0.1:5432/postgres?sslmode=disable&timezone=Asia/Shanghai
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
SERVER_ADDRESS=0.0.0.0:3000
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_BODY_LIMIT=1048576
# Comma-separated proxy IPs/CIDRs as seen by the API. Empty ignores X-Real-IP.
SERVER_TRUSTED_PROXIES=
ALLOWED_ORIGINS=http://localhost:5173,https://myproject.com
# Local-development placeholder only. Replace it in every deployed environment.
TOKEN_SYMMETRIC_KEY=local-dev-only-change-me-0000000
TOKEN_ISSUER=go-fiber-template
TOKEN_AUDIENCE=go-fiber-template-api
ACCESS_TOKEN_DURATION=30m
DEFAULT_LOCALE=zh
SUPPORTED_LOCALES=en,zh
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m
# Leave empty only when /metrics is protected by the surrounding network.
METRICS_TOKEN=
DEBUG=false
TRAFFIC_DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=15s
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=1s
