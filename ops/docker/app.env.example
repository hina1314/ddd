DB_DRIVER=postgres
# Use the same password as postgres.env; URL-encode it if it contains reserved characters.
DB_SOURCE=postgres://study:@db:5432/study?sslmode=disable
SERVER_ADDRESS=0.0.0.0:3000
ALLOWED_ORIGINS=http://localhost:5173
TOKEN_SYMMETRIC_KEY=
TRAFFIC_DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=15s
ACCESS_TOKEN_DURATION=30m
DEFAULT_LOCALE=zh
DEBUG=false
